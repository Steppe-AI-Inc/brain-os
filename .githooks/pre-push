#!/bin/sh
# Real structural safeguard for the exact gap this incident exposed: git push to files
# under supabase/functions/** auto-deploys to production (see
# docs/software-factory/PRODUCTION_DEPLOYMENT_PATHS.md). A purely-documented "remember to
# check" rule already failed once (this session knew the workflow existed and still
# pushed without checking) - this hook makes the check happen whether or not anyone
# remembers to run it.
#
# One-time setup per clone/worktree: `git config core.hooksPath .githooks`

remote="$1"
url="$2"

z40=0000000000000000000000000000000000000000
# The canonical empty-tree object hash (same in every git repo) - used below as the diff
# base only when a brand-new ref shares no history at all with the remote's default
# branch, so "everything in this ref" is the correct file set to check in that edge case.
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    continue # deleting a ref, nothing to check
  fi
  if [ "$remote_sha" = "$z40" ]; then
    # Brand-new branch/ref - what a first-ever `git push -u origin <branch>` looks like.
    # REAL BUG, confirmed live 2026-08-29: `range="$local_sha"` here previously fed a
    # single commit (no ".." range) to `git diff --name-only`, which diffs that commit
    # against the *working tree*, not against its own parent history - since the working
    # tree matches $local_sha exactly right after a commit, this always produced an EMPTY
    # changed-file list, silently letting every brand-new branch's first push skip the
    # functions/** check entirely regardless of what it actually touched. Reproduced live:
    # pushing a real branch that changed supabase/functions/sem-ai-command/index.ts with
    # no ALLOW_FUNCTIONS_DEPLOY set exited 0 instead of blocking (see
    # qa/scenarios-runner/pre_push_hook_blocks_function_deploy.sh for the permanent
    # regression covering this exact case). Diff against where this ref's history actually
    # forked from the remote's default branch instead - falling back to the empty-tree
    # hash (i.e. "diff the whole ref") only if there's truly no shared history at all (a
    # genuinely disjoint first-ever push).
    base=$(git merge-base "$local_sha" "$remote/master" 2>/dev/null || true)
    if [ -z "$base" ]; then
      base="$empty_tree"
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  changed=$(git diff --name-only "$range" -- 2>/dev/null)
  fn_changed=$(printf '%s\n' "$changed" | grep '^supabase/functions/' || true)

  if [ -n "$fn_changed" ]; then
    echo ""
    echo "============================================================"
    echo "  BLOCKED: this push touches supabase/functions/** paths:"
    echo ""
    printf '%s\n' "$fn_changed" | sed 's/^/    /'
    echo ""
    echo "  git push to master auto-deploys ALL Edge Functions to production"
    echo "  (supabase-functions.yml, live since 2026-08-28). This is a real"
    echo "  production deployment, not just source control - treat it with"
    echo "  the same rigor as a DB migration: independent review + explicit"
    echo "  founder awareness that THIS push is the deploy."
    echo ""
    echo "  If this is genuinely intended right now, override with:"
    echo "    ALLOW_FUNCTIONS_DEPLOY=1 git push ..."
    echo "============================================================"
    echo ""
    if [ -z "$ALLOW_FUNCTIONS_DEPLOY" ]; then
      exit 1
    fi
  fi
done

exit 0
