# Browser-safe values for frontend / Vercel
NEXT_PUBLIC_SUPABASE_URL=https://gyqlkgnyyzpwaswhshlw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SEM_BRAIN_APP_VERSION=0.7.1

# Backend-only values. Never expose these in browser JavaScript.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Required by api/ai-command.js and netlify/functions/ai-command.mjs (both fail closed,
# returning 401, if this is unset). Generate a long random value and also enter it in the
# app's Real AI Backend Connection settings ("Client key") so requests match. This is a
# stop-gap shared secret, not real per-user auth — prefer wiring the frontend to the
# Supabase Edge Function (supabase/functions/sem-ai-command), which checks a real
# per-user session, instead of these two endpoints where practical.
AI_COMMAND_SHARED_SECRET=generate_a_long_random_value
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_backend_only
SLACK_BOT_TOKEN=backend_only_later
GOOGLE_CLIENT_SECRET=backend_only_later
